# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Contact form uses Formsubmit.co — no API key needed (sends to SITE_CONFIG.contactEmail)

# Legacy (optional)
NEWSLETTER_API_KEY=
CONTACT_EMAIL=contact@isiata.com

# Site URL (used for canonical URLs, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://isiata.com

# Google Search Console verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Tsukuyomi Drum Engine — Stripe Checkout (server creates session; Cloudflare Worker handles license)
# Keep TSUKUYOMI_PURCHASE_ENABLED=false until you are ready to sell. Landing stays notify-only either way.
TSUKUYOMI_PURCHASE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
